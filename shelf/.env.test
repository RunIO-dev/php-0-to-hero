# The settings of Shelf's tests (chapter 77), read after .env when APP_ENV is test. In Git: tests need
# no secrets, and every copy of Shelf runs them the same way. The tests write only into var/.
APP_SECRET=a-secret-only-for-the-tests
SHELF_COVERS=var/test/covers
# Chapter 82: no email leaves a test; MailerAssertionsTrait reads what would have been sent.
MAILER_DSN=null://null
# Chapter 88: the tests' backups and heartbeat, in a folder of their own.
SHELF_DATA=var/test
