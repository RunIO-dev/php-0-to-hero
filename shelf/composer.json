{
    "name": "learner/shelf",
    "description": "Shelf: a small lending library, built in the course PHP from Zero to Hero.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Shelf\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Shelf\\Tests\\": "tests/"
        }
    }
}
