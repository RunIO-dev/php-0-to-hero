{# Too many requests from one address (chapter 82), with status 429 and a Retry-After header. #}
{% extends 'base.html.twig' %}

{% block title %}Slow down · Shelf{% endblock %}

{% block main %}
    <div class="problem">
        <p class="code" aria-hidden="true">429</p>
        <h1>Slow down</h1>
        <p>Shelf has sent several emails for this address in the last hour. Please try again later. <a href="{{ path('books') }}">Back to the books</a></p>
    </div>
{% endblock %}
