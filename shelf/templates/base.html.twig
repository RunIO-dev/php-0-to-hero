{# Shelf's page frame (chapter 73, from chapter 49's layout.php; chapter 80 gives it its finished look).
   Twig escapes every {{ value }} for HTML on its own. Hiding a link is a convenience; the security
   checks every request (chapter 76). Chapter 80:
   - a skip link, then the landmarks header, nav, main and footer, for keyboards and screen readers;
   - the current page is marked in the menu with aria-current, not by colour alone;
   - asset() names the stylesheet with its version (AssetMapper), so browsers may keep it for a year. #}
{% set member = app.user %}
{% set here = app.current_route %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Shelf{% endblock %}</title>
    <meta name="description" content="Shelf, the library: find a book, see what you have on loan.">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="{{ path('books') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="{{ path('books') }}"{% if here == 'books' %} aria-current="page"{% endif %}>Books</a>
{% if member is null %}
                <a href="{{ path('login') }}"{% if here == 'login' %} aria-current="page"{% endif %}>Log in</a>
                <a href="{{ path('signup') }}"{% if here == 'signup' %} aria-current="page"{% endif %}>Sign up</a>
{% else %}
                <a href="{{ path('loans') }}"{% if here == 'loans' %} aria-current="page"{% endif %}>My loans</a>
{% if is_granted('CHANGE_BOOKS') %}
                <a href="{{ path('add') }}"{% if here == 'add' %} aria-current="page"{% endif %}>Add a book</a>
{% endif %}
                <form class="account" method="post" action="{{ path('_logout_main') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                    <a class="who" href="{{ path('account') }}"{% if here == 'account' %} aria-current="page"{% endif %}>{{ member.name }}</a> <button class="link">Log out</button>
                </form>
{% endif %}
            </nav>
        </div>
    </header>
    <main id="main">
{% block main %}{% endblock %}
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <p>Shelf, the library of <em>PHP from Zero to Hero</em>.</p>
            <p>Code under the MIT licence.</p>
        </div>
    </footer>
</body>
</html>
