{# Shelf's page frame (chapter 73, from chapter 49's layout.php; chapter 80 gives it its finished look).
   Twig escapes every {{ value }} for HTML on its own. Hiding a link is a convenience; the security
   checks every request (chapter 76). Chapter 80:
   - a skip link, then the landmarks header, nav, main and footer, for keyboards and screen readers;
   - the current page is marked in the menu with aria-current, not by colour alone;
   - asset() names the stylesheet with its version (AssetMapper), so browsers may keep it for a year.
   Chapter 87: every text through |trans; the page's language and direction from the locale, which the
   address chose (/de/..., /ar/...); links to the same page in the other languages. #}
{% set member = app.user %}
{# Each route is there once per language (desk.de); _canonical_route is its name without the language. #}
{% set here = app.request.attributes.get('_canonical_route') ?? app.current_route %}
{% set locale = app.request.locale %}
{% set languages = {en: 'English', de: 'Deutsch', ar: 'العربية'} %}
{# The same page in another language: only for a page that GET shows; after a form, the books. #}
{% set same = app.request.method == 'GET' and here is not null %}
<!doctype html>
<html lang="{{ locale }}" dir="{{ locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Shelf{% endblock %}</title>
    <meta name="description" content="{{ 'Shelf, the library: find a book, see what you have on loan.'|trans }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% if same %}
{% for code in languages|keys|filter(code => code != locale) %}
    <link rel="alternate" hreflang="{{ code }}" href="{{ url(here, app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({_locale: code})) }}">
{% endfor %}
{% endif %}
</head>
<body>
    <a class="skip" href="#main">{{ 'Skip to the content'|trans }}</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="{{ path('books') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="{{ 'Main'|trans }}">
                <a href="{{ path('books') }}"{% if here == 'books' %} aria-current="page"{% endif %}>{{ 'Books'|trans }}</a>
{% if member is null %}
                <a href="{{ path('login') }}"{% if here == 'login' %} aria-current="page"{% endif %}>{{ 'Log in'|trans }}</a>
                <a href="{{ path('signup') }}"{% if here == 'signup' %} aria-current="page"{% endif %}>{{ 'Sign up'|trans }}</a>
{% else %}
                <a href="{{ path('loans') }}"{% if here == 'loans' %} aria-current="page"{% endif %}>{{ 'My loans'|trans }}</a>
{% if is_granted('CHANGE_BOOKS') %}
                <a href="{{ path('add') }}"{% if here == 'add' %} aria-current="page"{% endif %}>{{ 'Add a book'|trans }}</a>
                <a href="{{ path('desk') }}"{% if here == 'desk' %} aria-current="page"{% endif %}>{{ 'Desk'|trans }}</a>
                <a href="{{ path('members') }}"{% if here == 'members' %} aria-current="page"{% endif %}>{{ 'Members'|trans }}</a>
                <a href="{{ path('dashboard') }}"{% if here in ['dashboard', 'history'] %} aria-current="page"{% endif %}>{{ 'Dashboard'|trans }}</a>
{% endif %}
                <form class="account" method="post" action="{{ path('logout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                    <a class="who" href="{{ path('account') }}"{% if here == 'account' %} aria-current="page"{% endif %}>{{ member.name }}</a> <button class="link">{{ 'Log out'|trans }}</button>
                </form>
{% endif %}
            </nav>
        </div>
    </header>
    <main id="main">
{% block main %}{% endblock %}
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <p>{{ 'Shelf, the library of <em>PHP from Zero to Hero</em>.'|trans|raw }}</p>
            <nav class="languages" aria-label="{{ 'Language'|trans }}">
{% for code, name in languages %}
{% if code == locale %}
                <a href="{{ path(same ? here : 'books', same ? app.request.attributes.get('_route_params')|merge(app.request.query.all) : {}) }}" lang="{{ code }}" aria-current="true">{{ name }}</a>
{% else %}
                <a href="{{ path(same ? here : 'books', (same ? app.request.attributes.get('_route_params')|merge(app.request.query.all) : {})|merge({_locale: code})) }}" lang="{{ code }}" hreflang="{{ code }}">{{ name }}</a>
{% endif %}
{% endfor %}
            </nav>
            <p>{{ 'Code under the MIT licence.'|trans }}</p>
        </div>
    </footer>
</body>
</html>
