{# The lending desk (chapter 83), for the staff: a form to lend a book, and every loan that isn't back,
   the soonest due first, each with "Back" and "Extend". The datalists suggest titles and names as
   they are typed, without JavaScript. Chapter 84: the copies set aside for reservations, each lent
   with one button; no "Extend" for a loan someone waits for. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Lending desk'|trans }} · Shelf{% endblock %}

{% block main %}
    <div class="page-head">
        <div>
            <h1>{{ 'Lending desk'|trans }}</h1>
            <p class="lead">{{ 'Lend books, take them back, and extend loans.'|trans }}</p>
        </div>
    </div>
{% include '_flash.html.twig' %}
{% if error %}
    <p class="error" role="alert">{{ error|trans }}</p>
{% endif %}
    <section class="panel" aria-labelledby="lend-head">
        <h2 id="lend-head">{{ 'Lend a book'|trans }}</h2>
        <form class="inline-form" method="post" action="{{ path('desk_lend') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
            <label>{{ 'Book'|trans }} <input name="title" value="{{ typed.title }}" required list="titles" autocomplete="off"></label>
            <label>{{ 'Member'|trans }} <input name="member" value="{{ typed.member }}" required list="names" autocomplete="off"></label>
            <button>{{ 'Lend'|trans }}</button>
        </form>
        <datalist id="titles">
{% for book in available %}
            <option value="{{ book.title }}">
{% endfor %}
        </datalist>
        <datalist id="names">
{% for member in members %}
            <option value="{{ member.name }}">
{% endfor %}
        </datalist>
    </section>
{% if ready is not empty %}
    <h2 class="section-head" id="ready">{{ 'Set aside'|trans }} <span class="count">{{ ready|length }}</span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th scope="col">{{ 'Book'|trans }}</th><th scope="col">{{ 'For'|trans }}</th><th scope="col">{{ 'Until'|trans }}</th><th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th></tr>
            </thead>
            <tbody>
{% for hold in ready %}
                <tr>
                    <td><a href="{{ path('book', {title: hold.book.title}) }}">{{ hold.book.title }}</a></td>
                    <td>{{ hold.member.name }}</td>
                    <td>{{ hold.readyUntil|format_date('medium', timezone: false) }}</td>
                    <td><div class="row-actions">
                        <form method="post" action="{{ path('desk_lend') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                            <input type="hidden" name="title" value="{{ hold.book.title }}">
                            <input type="hidden" name="member" value="{{ hold.member.name }}">
                            <button class="quiet" aria-label="{{ 'Lend {title} to {member}'|trans({title: hold.book.title, member: hold.member.name}) }}">{{ 'Lend'|trans }}</button>
                        </form>
                    </div></td>
                </tr>
{% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
    <h2 class="section-head">{{ 'On loan'|trans }} <span class="count">{{ loans|length }}</span></h2>
{% if loans is empty %}
{% embed 'components/_empty.html.twig' with {text: 'Every book is on the shelf.'} only %}{% endembed %}
{% else %}
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th scope="col">{{ 'Book'|trans }}</th><th scope="col">{{ 'Member'|trans }}</th><th scope="col">{{ 'Due back'|trans }}</th><th scope="col">{{ 'Status'|trans }}</th><th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th></tr>
            </thead>
            <tbody>
{% for loan in loans %}
                <tr>
                    <td><a href="{{ path('book', {title: loan.book.title}) }}">{{ loan.book.title }}</a></td>
                    <td>{{ loan.member.name }}</td>
                    <td>{{ loan.due|format_date('medium', timezone: false) }}{% if loan.renewals > 0 %} <small>{{ '(extended {count}×)'|trans({count: loan.renewals}) }}</small>{% endif %}</td>
                    <td>{% include 'components/_badge.html.twig' with {text: loan.due|due, level: loan.due|due_level} only %}</td>
                    <td><div class="row-actions">
                        <form method="post" action="{{ path('desk_return') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                            <input type="hidden" name="loan" value="{{ loan.id }}">
                            <button class="quiet" aria-label="{{ '{title} is back from {member}'|trans({title: loan.book.title, member: loan.member.name}) }}">{{ 'Back'|trans }}</button>
                        </form>
{% if not loan.isOverdue(today) and loan.renewals < constant('Shelf\\Loan::MAX_RENEWALS') and loan.id not in reserved %}
                        <form method="post" action="{{ path('renew') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                            <input type="hidden" name="loan" value="{{ loan.id }}">
                            <input type="hidden" name="from" value="desk">
                            <button class="quiet" aria-label="{{ 'Extend {title} for {member}'|trans({title: loan.book.title, member: loan.member.name}) }}">{{ 'Extend'|trans }}</button>
                        </form>
{% endif %}
                    </div></td>
                </tr>
{% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
