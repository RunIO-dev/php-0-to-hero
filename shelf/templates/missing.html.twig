{# An address with nothing behind it, with status 404. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Not found'|trans }} · Shelf{% endblock %}

{% block main %}
    <div class="problem">
        <p class="code" aria-hidden="true">404</p>
        <h1>{{ 'Not found'|trans }}</h1>
        <p>{{ 'There is nothing at this address.'|trans }} <a href="{{ path('books') }}">{{ 'Back to the books'|trans }}</a></p>
    </div>
{% endblock %}
