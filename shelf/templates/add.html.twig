{# The form to add a book (chapter 75): Symfony's form draws each field, with its value and its
   mistakes; form_end() adds the CSRF token, and what is left. #}
{% extends 'base.html.twig' %}
{% form_theme form 'form/shelf.html.twig' %}

{% block title %}Add a book · Shelf{% endblock %}

{% block main %}
    <p class="back"><a href="{{ path('books') }}">← All books</a></p>
    <h1>Add a book</h1>{{ form_errors(form) }}
    {{ form_start(form, {attr: {class: 'card'}}) }}
        <label>Title {{ form_widget(form.title) }}</label>{{ form_errors(form.title) }}
        <label>Author {{ form_widget(form.author) }}</label>{{ form_errors(form.author) }}
        <label>Year {{ form_widget(form.year) }}</label>{{ form_errors(form.year) }}
        <label>ISBN <small>optional</small> {{ form_widget(form.isbn) }}</label>{{ form_errors(form.isbn) }}
        <label>Cover <small>PNG or JPEG, up to 2 MB, optional</small>
            {{ form_widget(form.cover) }}</label>{{ form_errors(form.cover) }}
        <p class="actions"><button>Add the book</button> <a class="button quiet" href="{{ path('books') }}">Cancel</a></p>
    {{ form_end(form) }}
{% endblock %}
