{# A form without the right CSRF token (chapter 51): sent by another site, or opened before the session ended. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Expired'|trans }} · Shelf{% endblock %}

{% block main %}
    <h1>{{ 'This form has expired'|trans }}</h1>
    <p class="error" role="alert">{{ 'Nothing was saved.'|trans }}</p>
    <p>{{ 'Please <a href="{link}">open the form again</a> and send it once more.'|trans({link: path('add')})|raw }}</p>
{% endblock %}
