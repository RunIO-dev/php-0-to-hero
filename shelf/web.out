<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kindred · Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav>
            <a href="/">Books</a>
            <a href="/loans">My loans</a>
            <a class="button" href="/add">Add a book</a>
            <form class="who" method="post" action="/logout">
                <input type="hidden" name="_token" value="{{token}}">
                <span>Jonas</span> <button class="link">Log out</button>
            </form>
        </nav>
    </header>
    <main>
    <p class="back"><a href="/">← All books</a></p>
    <h1>Kindred</h1>
    <div class="card details">
        <span class="cover" aria-hidden="true">K</span>
        <div>
            <p>Octavia E. Butler, 1979</p>
        </div>
    </div>
    <form class="card" method="post" action="/copies">
        <input type="hidden" name="_token" value="{{token}}">
        <input type="hidden" name="title" value="Kindred">
        <label>Copies in the library <input name="copies" value="0" required inputmode="numeric"></label>
        <p class="actions"><button>Save</button></p>
    </form>
    <form class="card" method="post" action="/remove">
        <input type="hidden" name="_token" value="{{token}}">
        <input type="hidden" name="title" value="Kindred">
        <p>Removing a book takes it off the shelf for good, with its cover.</p>
        <p class="actions"><button class="danger">Remove this book</button></p>
    </form>
    </main>
</body>
</html>

