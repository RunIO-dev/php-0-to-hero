            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">P</span>
            <h2><a href="/book?title=Parable+of+the+Sower">Parable of the Sower</a></h2>
            <p>Octavia E. Butler, 1993</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">T</span>
            <h2><a href="/book?title=Things+Fall+Apart">Things Fall Apart</a></h2>
            <p>Chinua Achebe, 1958</p>
            <p class="status">Available</p>
        </li>
    </ul>
    <p class="count">5 books</p>
    </main>
</body>
</html>

