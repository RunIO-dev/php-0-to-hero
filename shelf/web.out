> GET /

< HTTP/1.1 200 OK
< Content-Type: text/html; charset=UTF-8

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav><a href="/">Books</a> <a class="button" href="/add">Add a book</a></nav>
    </header>
    <main>
    <h1>Books</h1>
    <ul class="books">
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2>Kindred</h2>
            <p>Octavia E. Butler, 1979</p>
            <p class="status on-loan">All copies on loan</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2>Kitchen</h2>
            <p>Banana Yoshimoto, 1988</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">P</span>
            <h2>Parable of the Sower</h2>
            <p>Octavia E. Butler, 1993</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">T</span>
            <h2>Things Fall Apart</h2>
            <p>Chinua Achebe, 1958</p>
            <p class="status">Available</p>
        </li>
    </ul>
    <p class="count">4 books</p>
    </main>
</body>
</html>

> GET /add

< HTTP/1.1 200 OK
< Set-Cookie: shelf=…; path=/; secure; HttpOnly; SameSite=Lax
< Content-Type: text/html; charset=UTF-8

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add a book · Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav><a href="/">Books</a> <a class="button" href="/add">Add a book</a></nav>
    </header>
    <main>
    <h1>Add a book</h1>
    <form class="card" method="post" action="/add" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{token}}">
        <label>Title <input name="title" value="" required maxlength="200"></label>
        <label>Author <input name="author" value="" required maxlength="200"></label>
        <label>Year <input name="year" value="" required inputmode="numeric"></label>
        <label>ISBN <small>optional</small> <input name="isbn" value=""></label>
        <label>Cover <small>PNG or JPEG, up to 2 MB, optional</small>
            <input type="file" name="cover" accept="image/png, image/jpeg"></label>
        <p class="actions"><button>Add the book</button> <a href="/">Cancel</a></p>
    </form>
    </main>
</body>
</html>

