<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav>
            <a href="/">Books</a>
            <a href="/login">Log in</a>
        </nav>
    </header>
    <main>
    <h1>Books</h1>
    <ul class="books">
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2><a href="/book?title=Kindred">Kindred</a></h2>
            <p>Octavia E. Butler, 1979</p>
            <p class="status on-loan">All copies on loan</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2><a href="/book?title=Kitchen">Kitchen</a></h2>
            <p>Banana Yoshimoto, 1988</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">P</span>
            <h2><a href="/book?title=Parable+of+the+Sower">Parable of the Sower</a></h2>
            <p>Octavia E. Butler, 1993</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">T</span>
            <h2><a href="/book?title=Things+Fall+Apart">Things Fall Apart</a></h2>
            <p>Chinua Achebe, 1958</p>
            <p class="status">Available</p>
        </li>
    </ul>
    <p class="count">4 books</p>
    </main>
</body>
</html>

