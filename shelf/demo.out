<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lending desk · Shelf</title>
    <meta name="description" content="Shelf, the library: find a book, see what you have on loan.">
    <link rel="stylesheet" href="/assets/styles/app-Hs092GZ.css">
    <link rel="alternate" hreflang="de" href="http://localhost:8000/de/desk">
    <link rel="alternate" hreflang="ar" href="http://localhost:8000/ar/desk">
</head>
<body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/">Books</a>
                <a href="/loans">My loans</a>
                <a href="/add">Add a book</a>
                <a href="/desk" aria-current="page">Desk</a>
                <a href="/members">Members</a>
                <a href="/dashboard">Dashboard</a>
                <form class="account" method="post" action="/logout">
                    <input type="hidden" name="_token" value="…">
                    <a class="who" href="/account">Jonas</a> <button class="link">Log out</button>
                </form>
            </nav>
        </div>
    </header>
    <main id="main">
        <p class="notice">A demo: try anything. Every night at 03:00 UTC, it all goes back as it was.</p>
    <div class="page-head">
        <div>
            <h1>Lending desk</h1>
            <p class="lead">Lend books, take them back, and extend loans.</p>
        </div>
    </div>
    <p class="flash" role="status">Welcome, Jonas.</p>
    <section class="panel" aria-labelledby="lend-head">
        <h2 id="lend-head">Lend a book</h2>
        <form class="inline-form" method="post" action="/desk/lend">
            <input type="hidden" name="_token" value="…">
            <label>Book <input name="title" value="" required list="titles" autocomplete="off"></label>
            <label>Member <input name="member" value="" required list="names" autocomplete="off"></label>
            <button>Lend</button>
        </form>
        <datalist id="titles">
            <option value="Adventures of Huckleberry Finn">
            <option value="All Quiet on the Western Front">
            <option value="Americanah">
            <option value="Animal Farm">
            <option value="Brave New World">
            <option value="Buddenbrooks">
            <option value="Crime and Punishment">
            <option value="Don Quixote">
            <option value="Dracula">
            <option value="Frankenstein">
            <option value="Great Expectations">
            <option value="Half of a Yellow Sun">
            <option value="Heart of Darkness">
            <option value="Invisible Man">
            <option value="Jane Eyre">
            <option value="Kafka on the Shore">
            <option value="Madame Bovary">
            <option value="Men in the Sun">
            <option value="Middlemarch">
            <option value="Midnight&#039;s Children">
            <option value="Moby-Dick">
            <option value="Never Let Me Go">
            <option value="Nineteen Eighty-Four">
            <option value="Norwegian Wood">
            <option value="One Hundred Years of Solitude">
            <option value="Palace Walk">
            <option value="Parable of the Sower">
            <option value="Pride and Prejudice">
            <option value="Siddhartha">
            <option value="Steppenwolf">
            <option value="The Brothers Karamazov">
            <option value="The Color Purple">
            <option value="The Dispossessed">
            <option value="The God of Small Things">
            <option value="The Grapes of Wrath">
            <option value="The Great Gatsby">
            <option value="The Left Hand of Darkness">
            <option value="The Little Prince">
            <option value="The Metamorphosis">
            <option value="The Name of the Rose">
            <option value="The Old Man and the Sea">
            <option value="The Picture of Dorian Gray">
            <option value="The Remains of the Day">
            <option value="The Stranger">
            <option value="The Trial">
            <option value="To the Lighthouse">
            <option value="Ulysses">
            <option value="War and Peace">
        </datalist>
        <datalist id="names">
            <option value="Amira">
            <option value="Ana">
            <option value="Jonas">
            <option value="Kenji">
        </datalist>
    </section>
    <h2 class="section-head">On loan <span class="count">3</span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th scope="col">Book</th><th scope="col">Member</th><th scope="col">Due back</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><a href="/book?title=Things%20Fall%20Apart">Things Fall Apart</a></td>
                    <td>Kenji</td>
                    <td>Nov 2, 2026</td>
                    <td><span class="badge danger">16 days overdue</span>
</td>
                    <td><div class="row-actions">
                        <form method="post" action="/desk/return">
                            <input type="hidden" name="_token" value="…">
                            <input type="hidden" name="loan" value="1">
                            <button class="quiet" aria-label="Things Fall Apart is back from Kenji">Back</button>
                        </form>
                    </div></td>
                </tr>
                <tr>
                    <td><a href="/book?title=Things%20Fall%20Apart">Things Fall Apart</a></td>
                    <td>Amira</td>
                    <td>Nov 20, 2026</td>
                    <td><span class="badge warn">due in 2 days</span>
</td>
                    <td><div class="row-actions">
                        <form method="post" action="/desk/return">
                            <input type="hidden" name="_token" value="…">
                            <input type="hidden" name="loan" value="2">
                            <button class="quiet" aria-label="Things Fall Apart is back from Amira">Back</button>
                        </form>
                        <form method="post" action="/renew">
                            <input type="hidden" name="_token" value="…">
                            <input type="hidden" name="loan" value="2">
                            <input type="hidden" name="from" value="desk">
                            <button class="quiet" aria-label="Extend Things Fall Apart for Amira">Extend</button>
                        </form>
                    </div></td>
                </tr>
                <tr>
                    <td><a href="/book?title=Kitchen">Kitchen</a></td>
                    <td>Ana</td>
                    <td>Nov 22, 2026</td>
                    <td><span class="badge ok">due in 4 days</span>
</td>
                    <td><div class="row-actions">
                        <form method="post" action="/desk/return">
                            <input type="hidden" name="_token" value="…">
                            <input type="hidden" name="loan" value="3">
                            <button class="quiet" aria-label="Kitchen is back from Ana">Back</button>
                        </form>
                    </div></td>
                </tr>
            </tbody>
        </table>
    </div>
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <p>Shelf, the library of <em>PHP from Zero to Hero</em>.</p>
            <nav class="languages" aria-label="Language">
                <a href="/desk" lang="en" aria-current="true">English</a>
                <a href="/de/desk" lang="de" hreflang="de">Deutsch</a>
                <a href="/ar/desk" lang="ar" hreflang="ar">العربية</a>
            </nav>
            <p>Code under the MIT licence.</p>
        </div>
    </footer>
</body>
</html>

