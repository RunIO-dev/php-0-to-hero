# Caddy, Shelf's web server (chapter 78). For a real domain, it gets a certificate from Let's Encrypt
# on its own, renews it, and sends every http:// request to https://. For localhost, it makes a
# certificate of its own, which browsers warn about: fine for a try on your computer.
{$SHELF_HOST:localhost} {
	root * /app/public
	encode zstd gzip

	# Files that exist in public/ (the stylesheet) come from Caddy; every other request goes to
	# index.php in the app container, through FastCGI, with HTTPS=on.
	php_fastcgi app:9000
	file_server

	header {
		# Browsers come back over HTTPS only, for a year.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
