# Shelf's settings (chapter 65). This file is in Git, so it holds no secrets: only what a new copy
# of Shelf needs on a developer's computer. To change a setting on your computer only, write it into
# .env.local, which Git ignores. A server sets real environment variables, which win over both files.
SHELF_ENV=development
SHELF_DATABASE=var/shelf.sqlite
SHELF_COVERS=storage/covers
SHELF_LOG=var/log/shelf.log
