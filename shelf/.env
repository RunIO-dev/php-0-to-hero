# Shelf's settings (chapter 65). This file is in Git, so it holds no secrets: only what a new copy
# of Shelf needs on a developer's computer. To change a setting on your computer only, write it into
# .env.local, which Git ignores. A server sets real environment variables, which win over both files.
# Paths are relative to shelf/. The log is a whole path (chapter 78: or php://stderr in a container).
SHELF_COVERS=storage/covers
SHELF_LOG="%kernel.project_dir%/var/log/shelf_%kernel.environment%.log"

# Symfony's own (chapter 72): dev, test or prod, and the secret, which .env.dev sets for developers.
APP_ENV=dev
APP_SECRET=

# The database (chapter 74), as Doctrine names it: SQLite, in a file in var/, one per environment, so
# the tests (chapter 77) never touch the one you use. MariaDB would be, for example:
# DATABASE_URL="mysql://shelf_app:password@db:3306/shelf?serverVersion=11.8.0-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/shelf_%kernel.environment%.sqlite"

# Email (chapter 82): where Symfony Mailer sends it, and who it comes from. On your computer, Mailpit
# catches every message (docker compose up web starts it): read them at http://localhost:8025.
# A server sets its own, for example sendmail://default, or smtp://user:password@host:587.
MAILER_DSN=smtp://mailpit:1025
SHELF_MAIL_FROM="Shelf <shelf@localhost>"

# Chapter 85: Messenger's queue, a table in the same database (made by a migration, so auto_setup=0),
# and the site's address, for the links in emails that the worker sends, where there is no request.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
SHELF_URL=http://localhost:8000
