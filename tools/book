#!/usr/bin/env php
<?php

declare(strict_types=1);

// Builds the book into site/: one HTML page per chapter, a contents page, book.html with
// every chapter for printing, book-kdp-N.html (the paperback's volumes) with cover-kdp-N.html, and book-extended.html
// (the extended edition: every file and every answer in full). It fails when a listing of the
// book is longer than Book::MAX_LINES.
//   composer book    the HTML; then tools/pdf prints book.html to a PDF with Chrome

use Tools\Book;
use Tools\Run;

require __DIR__ . '/bootstrap.php';

$root = dirname(__DIR__);
// Optional argument: another output folder (tools/verify builds into a temporary one, so site/ and its PDF stay).
$site = $_SERVER['argv'][1] ?? $root . '/site';

// Start from an empty site/, so a removed chapter or edition does not linger.
Run::remove($site);
mkdir($site);
copy($root . '/tools/book.css', $site . '/book.css');
copy($root . '/tools/kdp.css', $site . '/kdp.css');
copy($root . '/tools/cover.css', $site . '/cover.css');
mkdir($site . '/fonts');
foreach (glob($root . '/tools/fonts/*') ?: [] as $font) {
    copy($font, $site . '/fonts/' . basename($font));
}

$composer = json_decode((string) file_get_contents($root . '/composer.json'), true, 512, JSON_THROW_ON_ERROR);
$author = $composer['authors'][0] ?? throw new RuntimeException('composer.json needs "authors" for the cover');
// the edition date: the last commit, so the same source always builds the same book
$date = trim(Run::capture(['git', '-c', "safe.directory=$root", '-C', $root, 'log', '-1', '--format=%cs'])['out']) ?: date('Y-m-d');

$built = [];
$long = [];
foreach (glob($root . '/book/*', GLOB_ONLYDIR) ?: [] as $dir) {
    $lang = basename($dir);
    $out = "$site/$lang";
    mkdir($out);
    $chapters = [];
    $contents = [];
    $all = '';
    $extended = '';
    $articles = []; // chapter number → its <article>, for the paperback's volumes
    $shown = []; // the short edition: the files each chapter showed, so a later chapter shows its changes only
    foreach (glob($dir . '/*.md') ?: [] as $file) {
        $source = (string) file_get_contents($file);
        $heading = preg_match('/^# (.+)$/m', $source, $m) === 1 ? trim($m[1]) : basename($file, '.md');
        $title = (string) preg_replace('/^\d+\.\s*/', '', $heading);
        $html = Book::structure(Book::html(Book::expand($root, $source, $lang, $shown)), $lang);
        foreach (Book::tooLong($html) as $listing) {
            $long[] = "book/$lang/" . basename($file) . ": $listing (at most " . Book::MAX_LINES . ': show an excerpt, `lines 40-75` or `requests 2-4`)';
        }
        // the extended edition: every file and every answer in full
        $extended .= "<article class=\"chapter\">\n" . Book::structure(Book::html(Book::expand($root, $source, $lang)), $lang) . "</article>\n";
        $page = basename($file, '.md') . '.html';
        file_put_contents("$out/$page", Book::page("$title · " . Book::TITLE, $html, $lang));
        $chapters[] = [(int) basename($file), $title];
        $contents[] = sprintf('<li><a href="%s">%s</a></li>', $page, htmlspecialchars($heading, ENT_QUOTES));
        $articles[(int) basename($file)] = "<article class=\"chapter\">\n$html</article>\n";
        $all .= $articles[(int) basename($file)];
    }
    file_put_contents("$out/index.html", Book::page(Book::TITLE, '<h1>' . Book::TITLE . "</h1>\n<ol>\n" . implode("\n", $contents) . "\n</ol>", $lang));
    $book = Book::front($lang, '8.6', $chapters, $author, $date) . $all;
    file_put_contents("$out/book.html", Book::page(Book::TITLE, $book, $lang, 'print'));
    file_put_contents("$out/book-extended.html", Book::page(Book::TITLE, Book::front($lang, '8.6', $chapters, $author, $date, null, true) . $extended, $lang, 'print'));
    // the paperback's interior for KDP: the same chapters, with kdp.css for 7 × 10 in, black and white,
    // in two volumes (KDP prints at most 828 pages); and each volume's cover, from book/<lang>/cover.json
    $covers = is_file("$dir/cover.json") ? json_decode((string) file_get_contents("$dir/cover.json"), true, 512, JSON_THROW_ON_ERROR) : [];
    foreach (Book::VOLUMES as $volume => [$first, $last]) {
        $in = array_filter($chapters, static fn(array $c): bool => $c[0] >= $first && $c[0] <= $last);
        if ($in === []) {
            continue;
        }
        $body = Book::front($lang, '8.6', array_values($in), $author, $date, $volume)
            . implode('', array_filter($articles, static fn(int $n): bool => $n >= $first && $n <= $last, ARRAY_FILTER_USE_KEY));
        file_put_contents("$out/book-kdp-$volume.html", Book::page(Book::TITLE, $body, $lang, 'print kdp', ['../book.css', '../kdp.css']));
        if (isset($covers[(string) $volume])) {
            file_put_contents("$out/cover-kdp-$volume.html", Book::cover($lang, '8.6', $volume, $first, $last, $author, $covers[(string) $volume]));
        }
    }
    $built[] = "$lang: " . count($chapters) . ' chapter(s)';
}

if ($long !== []) {
    fwrite(STDERR, "Listings too long for the book:\n  " . implode("\n  ", $long) . "\n");
    exit(1);
}
echo 'Book built in site/ (' . ($built === [] ? 'no chapters yet' : implode('; ', $built)) . ")\n";
