#!/usr/bin/env php
<?php

declare(strict_types=1);

// Writes the .out file next to each example: exactly what the check expects.
//   php tools/out code/06-variables/*.php
// Read every .out before you commit it: it becomes the expected output.
// An example with a .phpstan file (chapter 40) gets it written again too: write its first
// line, the command, by hand: $ vendor/bin/phpstan analyse --level 6 code/NN-slug/x.php

use Tools\Analysis;
use Tools\Examples;
use Tools\Projects;

require __DIR__ . '/bootstrap.php';

$root = dirname(__DIR__);
foreach (Projects::prepare($root) as $problem) {
    fwrite(STDERR, "$problem\n");
}
foreach (array_slice($_SERVER['argv'], 1) as $path) {
    $file = realpath($path);
    if ($file !== false && str_ends_with($file, '.http') && !is_file(substr($file, 0, -5) . '.php')) {
        file_put_contents(substr($file, 0, -5) . '.out', Examples::siteOutput($root, $file));
        echo substr($file, 0, -5) . ".out\n";
        continue;
    }
    if ($file === false || !str_ends_with($file, '.php') || str_ends_with($file, '.bad.php') && !Tools\Web::has($file)
        || in_array($file, Tools\Web::served(dirname($file)), true) && !Tools\Web::has($file) || Examples::isTemplate($file)) {
        fwrite(STDERR, "skipped: $path\n");
        continue;
    }
    file_put_contents(substr($file, 0, -4) . '.out', Examples::output($root, $file));
    echo substr($file, 0, -4) . ".out\n";
    if (Analysis::has($file)) {
        Analysis::write($root, $file);
        echo substr($file, 0, -4) . ".phpstan\n";
    }
}
