{
    "name": "runio-dev/php-0-to-hero",
    "description": "PHP from zero to hero: a free book and video course with tested code.",
    "type": "project",
    "license": [
        "CC-BY-4.0",
        "MIT"
    ],
    "authors": [
        {
            "name": "Amer Malik Mohammed",
            "homepage": "https://runio.dev",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tools\\": "tools/src/"
        }
    },
    "scripts": {
        "check": "php tools/check.php",
        "verify": "php tools/verify",
        "exercise": "php tools/exercise",
        "book": "php tools/book",
        "out": "php tools/out"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "require-dev": {
        "doctrine/orm": "^3.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/commonmark": "^2.10",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "sebastian/diff": "^9.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/password-hasher": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/validator": "7.4.*",
        "tempest/highlight": "^2.30",
        "twig/intl-extra": "^3.21",
        "twig/twig": "^3.22"
    }
}
