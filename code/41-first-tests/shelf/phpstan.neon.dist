# Static analysis for Shelf (chapter 40; its tests from chapter 41), at the highest level. From the course folder:
#   vendor/bin/phpstan analyse -c shelf/phpstan.neon.dist
parameters:
    level: 10
    paths:
        - shelf.php
        - src
        - tests
    ignoreErrors:
        # PHP always sets $argv when it runs a script from the command line.
        -
            message: '#^Variable \$argv might not be defined\.$#'
            path: shelf.php
