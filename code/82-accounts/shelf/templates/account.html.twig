{# A member's own account (chapter 82): who they are, and three forms, each asking for the current
   password. errors holds the message of the form that went wrong: password, email or delete. #}
{% extends 'base.html.twig' %}

{% block title %}Your account · Shelf{% endblock %}

{% macro error(errors, form) %}
{% if errors[form] is defined %}
            <p class="error" role="alert">{{ errors[form] }}</p>
{% endif %}
{% endmacro %}

{% block main %}
    <div class="page-head">
        <div>
            <h1>Your account</h1>
            <p class="lead">{{ member.name }} · {{ member.email ?? 'no email address yet' }}</p>
        </div>
    </div>
{% include '_flash.html.twig' %}
    <div class="panels">
        <section class="panel" aria-labelledby="password-head">
            <h2 id="password-head">Password</h2>
{{ _self.error(errors, 'password') }}
            <form method="post" action="{{ path('account_password') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
                <label>New password <small>At least 15 characters</small>
                    <input type="password" name="password" required minlength="15" autocomplete="new-password"></label>
                <p class="actions"><button>Change the password</button></p>
            </form>
        </section>
        <section class="panel" aria-labelledby="email-head">
            <h2 id="email-head">Email</h2>
{{ _self.error(errors, 'email') }}
            <form method="post" action="{{ path('account_email') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>New address <input type="email" name="email" required autocomplete="email"></label>
                <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
                <p class="actions"><button>Send a link to the new address</button></p>
            </form>
        </section>
        <section class="panel danger" aria-labelledby="delete-head">
            <h2 id="delete-head">Delete your account</h2>
            <p>Your name, address and password are deleted at once, and can't be brought back.</p>
{{ _self.error(errors, 'delete') }}
            <form method="post" action="{{ path('account_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
                <p class="actions"><button class="danger">Delete my account</button></p>
            </form>
        </section>
    </div>
{% endblock %}
