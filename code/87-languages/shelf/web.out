    <meta name="description" content="Shelf, the library: find a book, see what you have on loan.">
    <link rel="stylesheet" href="/assets/styles/app-Hs092GZ.css">
</head>
<body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/">Books</a>
                <a href="/loans">My loans</a>
                <a href="/add" aria-current="page">Add a book</a>
                <a href="/desk">Desk</a>
                <a href="/members">Members</a>
                <a href="/dashboard">Dashboard</a>
                <form class="account" method="post" action="/logout">
                    <input type="hidden" name="_token" value="…">
                    <a class="who" href="/account">Jonas</a> <button class="link">Log out</button>
                </form>
            </nav>
        </div>
    </header>
    <main id="main">
    <p class="back"><a href="/">← All books</a></p>
    <h1>Add a book</h1>
    <form method="post" action="/add" class="card" enctype="multipart/form-data">
        <label>Title <input type="text" id="title" name="title" required="required" maxlength="200" value="Sula" /></label>
        <label>Author <input type="text" id="author" name="author" required="required" maxlength="200" value="Toni Morrison" /></label>
        <label>Year <input type="number" id="year" name="year" required="required" inputmode="numeric" value="1973" /></label>
        <label>ISBN <small>optional</small> <input type="text" id="isbn" name="isbn" /></label>
        <label>Cover <small>PNG or JPEG, up to 2 MB, optional</small>
            <input type="file" id="cover" name="cover" accept="image/png, image/jpeg" /></label>
    <p class="error" role="alert">A cover must be a PNG or JPEG image.</p>
        <p class="actions"><button>Add the book</button> <a class="button quiet" href="/">Cancel</a></p>
    <input type="hidden" id="_token" name="_token" data-controller="csrf-protection" value="…" /></form>
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <p>Shelf, the library of <em>PHP from Zero to Hero</em>.</p>
