            <option value="Palace Walk">
            <option value="Parable of the Sower">
            <option value="Pride and Prejudice">
            <option value="Siddhartha">
            <option value="Steppenwolf">
            <option value="Sula">
            <option value="The Brothers Karamazov">
            <option value="The Color Purple">
            <option value="The Dispossessed">
            <option value="The God of Small Things">
            <option value="The Grapes of Wrath">
            <option value="The Great Gatsby">
            <option value="The Left Hand of Darkness">
            <option value="The Little Prince">
            <option value="The Metamorphosis">
            <option value="The Name of the Rose">
            <option value="The Old Man and the Sea">
            <option value="The Picture of Dorian Gray">
            <option value="The Remains of the Day">
            <option value="The Stranger">
            <option value="The Trial">
            <option value="Things Fall Apart">
            <option value="To the Lighthouse">
