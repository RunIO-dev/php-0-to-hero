<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lending desk · Shelf</title>
    <meta name="description" content="Shelf, the library: find a book, see what you have on loan.">
    <link rel="stylesheet" href="/assets/styles/app-Hs092GZ.css">
    <link rel="alternate" hreflang="de" href="http://localhost:8000/de/desk">
    <link rel="alternate" hreflang="ar" href="http://localhost:8000/ar/desk">
</head>
<body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/">Books</a>
                <a href="/loans">My loans</a>
                <a href="/add">Add a book</a>
                <a href="/desk" aria-current="page">Desk</a>
                <a href="/members">Members</a>
                <a href="/dashboard">Dashboard</a>
                <form class="account" method="post" action="/logout">
                    <input type="hidden" name="_token" value="{{token}}">
                    <a class="who" href="/account">Jonas</a> <button class="link">Log out</button>
                </form>
            </nav>
        </div>
    </header>
    <main id="main">
    <div class="page-head">
        <div>
            <h1>Lending desk</h1>
            <p class="lead">Lend books, take them back, and extend loans.</p>
        </div>
    </div>
    <section class="panel" aria-labelledby="lend-head">
        <h2 id="lend-head">Lend a book</h2>
        <form class="inline-form" method="post" action="/desk/lend">
            <input type="hidden" name="_token" value="…">
            <label>Book <input name="title" value="" required list="titles" autocomplete="off"></label>
            <label>Member <input name="member" value="" required list="names" autocomplete="off"></label>
            <button>Lend</button>
        </form>
        <datalist id="titles">
            <option value="Adventures of Huckleberry Finn">
            <option value="All Quiet on the Western Front">
            <option value="Americanah">
            <option value="Animal Farm">
            <option value="Brave New World">
            <option value="Buddenbrooks">
            <option value="Crime and Punishment">
            <option value="Don Quixote">
            <option value="Dracula">
            <option value="Frankenstein">
            <option value="Great Expectations">
            <option value="Half of a Yellow Sun">
            <option value="Heart of Darkness">
            <option value="Invisible Man">
            <option value="Jane Eyre">
            <option value="Kafka on the Shore">
            <option value="Kitchen">
            <option value="Madame Bovary">
            <option value="Men in the Sun">
            <option value="Middlemarch">
            <option value="Midnight&#039;s Children">
            <option value="Moby-Dick">
            <option value="Never Let Me Go">
            <option value="Nineteen Eighty-Four">
            <option value="Norwegian Wood">
            <option value="One Hundred Years of Solitude">
            <option value="Palace Walk">
            <option value="Parable of the Sower">
            <option value="Pride and Prejudice">
            <option value="Siddhartha">
            <option value="Steppenwolf">
            <option value="Sula">
            <option value="The Brothers Karamazov">
            <option value="The Color Purple">
