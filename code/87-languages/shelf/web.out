    <link rel="alternate" hreflang="ar" href="http://localhost:8000/ar/book?title=Kindred">
</head>
<body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site">
        <div class="site-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/">Books</a>
                <a href="/loans">My loans</a>
                <a href="/add">Add a book</a>
                <a href="/desk">Desk</a>
                <a href="/members">Members</a>
                <a href="/dashboard">Dashboard</a>
                <form class="account" method="post" action="/logout">
                    <input type="hidden" name="_token" value="…">
                    <a class="who" href="/account">Jonas</a> <button class="link">Log out</button>
                </form>
            </nav>
        </div>
    </header>
    <main id="main">
    <p class="back"><a href="/">← All books</a></p>
    <div class="book-page">
    <span class="cover tone-0" aria-hidden="true">K</span>
        <div>
            <h1>Kindred</h1>
            <dl class="facts">
                <dt>Author</dt>
                <dd>Octavia E. Butler</dd>
                <dt>Year</dt>
                <dd>1979</dd>
                <dt>On the shelf</dt>
                <dd>
<span class="badge warn">All copies on loan</span>
                </dd>
            </dl>
            <section class="panel" aria-labelledby="reserve-head">
                <h2 id="reserve-head">Reserve</h2>
                <form method="post" action="/reserve">
                    <input type="hidden" name="_token" value="…">
                    <input type="hidden" name="title" value="Kindred">
                    <p>Every copy is out. Reserve it, and the next copy that comes back is kept for you.</p>
                    <p class="actions"><button>Reserve</button></p>
                </form>
            </section>
            <section class="panel" aria-labelledby="staff">
                <h2 id="staff">For the library&#039;s staff</h2>
                <form class="inline-form" method="post" action="/copies">
                    <input type="hidden" name="_token" value="…">
                    <input type="hidden" name="title" value="Kindred">
                    <label>Copies on the shelf <input name="copies" value="0" required inputmode="numeric"></label>
                    <button>Save</button>
                </form>
            </section>
            <section class="panel" aria-labelledby="remove">
                <h2 id="remove">Remove this book</h2>
                <form method="post" action="/remove">
                    <input type="hidden" name="_token" value="…">
                    <input type="hidden" name="title" value="Kindred">
                    <p>This takes it off the shelf for good, with its cover.</p>
                    <p class="actions"><button class="danger">Remove this book</button></p>
                </form>
            </section>
        </div>
    </div>
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <p>Shelf, the library of <em>PHP from Zero to Hero</em>.</p>
            <nav class="languages" aria-label="Language">
                <a href="/book?title=Kindred" lang="en" aria-current="true">English</a>
                <a href="/de/book?title=Kindred" lang="de" hreflang="de">Deutsch</a>
                <a href="/ar/book?title=Kindred" lang="ar" hreflang="ar">العربية</a>
            </nav>
            <p>Code under the MIT licence.</p>
        </div>
    </footer>
</body>
</html>

