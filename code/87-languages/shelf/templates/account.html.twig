{# A member's own account (chapter 82): who they are, and three forms, each asking for the current
   password. errors holds the message of the form that went wrong: password, email or delete. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Your account'|trans }} · Shelf{% endblock %}

{% macro error(errors, form) %}
{% if errors[form] is defined %}
            <p class="error" role="alert">{{ errors[form]|trans }}</p>
{% endif %}
{% endmacro %}

{% block main %}
    <div class="page-head">
        <div>
            <h1>{{ 'Your account'|trans }}</h1>
            <p class="lead">{{ member.name }} · {{ member.email ?? 'no email address yet'|trans }}</p>
        </div>
    </div>
{% include '_flash.html.twig' %}
    <div class="panels">
        <section class="panel" aria-labelledby="password-head">
            <h2 id="password-head">{{ 'Password'|trans }}</h2>
{{ _self.error(errors, 'password') }}
            <form method="post" action="{{ path('account_password') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>{{ 'Current password'|trans }} <input type="password" name="current" required autocomplete="current-password"></label>
                <label>{{ 'New password'|trans }} <small>{{ 'At least 15 characters'|trans }}</small>
                    <input type="password" name="password" required minlength="15" autocomplete="new-password"></label>
                <p class="actions"><button>{{ 'Change the password'|trans }}</button></p>
            </form>
        </section>
        <section class="panel" aria-labelledby="email-head">
            <h2 id="email-head">{{ 'Email'|trans }}</h2>
{{ _self.error(errors, 'email') }}
            <form method="post" action="{{ path('account_email') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>{{ 'New address'|trans }} <input type="email" name="email" required autocomplete="email"></label>
                <label>{{ 'Current password'|trans }} <input type="password" name="current" required autocomplete="current-password"></label>
                <p class="actions"><button>{{ 'Send a link to the new address'|trans }}</button></p>
            </form>
        </section>
        <section class="panel danger" aria-labelledby="delete-head">
            <h2 id="delete-head">{{ 'Delete your account'|trans }}</h2>
            <p>{{ "Your name, address and password are deleted at once, and can't be brought back."|trans }}</p>
{{ _self.error(errors, 'delete') }}
            <form method="post" action="{{ path('account_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('shelf') }}">
                <label>{{ 'Current password'|trans }} <input type="password" name="current" required autocomplete="current-password"></label>
                <p class="actions"><button class="danger">{{ 'Delete my account'|trans }}</button></p>
            </form>
        </section>
    </div>
{% endblock %}
