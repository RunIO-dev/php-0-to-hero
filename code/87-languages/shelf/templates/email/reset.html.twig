{% extends 'email/base.html.twig' %}

{% block body %}
<p>{{ 'Hello {name},'|trans({name: name}) }}</p>
<p>{{ 'choose a new password for Shelf here:'|trans }}</p>
<p><a class="button" href="{{ link }}">{{ 'Choose a new password'|trans }}</a></p>
<p class="small">{{ 'The link works for an hour, and once. If you didn\'t ask for it, your password stays as it is: you can ignore this message.'|trans }}</p>
{% endblock %}
