{% extends 'email/base.html.twig' %}

{% block body %}
<p>{{ 'Hello {name},'|trans({name: name}) }}</p>
<p>{{ '“{title}” was due back on {day}. Please bring it back to the library: someone may be waiting for it.'|trans({title: title, day: day|format_date('full', timezone: false)}) }}</p>
<p><a class="button" href="{{ link }}">{{ 'My loans'|trans }}</a></p>
{% endblock %}
