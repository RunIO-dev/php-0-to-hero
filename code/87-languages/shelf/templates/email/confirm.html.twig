{% extends 'email/base.html.twig' %}

{% block body %}
<p>{{ 'Hello {name},'|trans({name: name}) }}</p>
<p>{{ 'please confirm that this address is yours, for your account at Shelf:'|trans }}</p>
<p><a class="button" href="{{ link }}">{{ 'Confirm my address'|trans }}</a></p>
<p class="small">{{ 'The link works for two days. If you didn\'t ask for it, nothing happens: you can ignore this message.'|trans }}</p>
{% endblock %}
