{% extends 'email/base.html.twig' %}

{% block body %}
<p>{{ 'Hello {name},'|trans({name: name}) }}</p>
<p>{{ 'someone just signed up at Shelf with this address, which already has your account. If it was you: log in as {name}, or choose a new password, within an hour:'|trans({name: name}) }}</p>
<p><a class="button" href="{{ link }}">{{ 'Choose a new password'|trans }}</a></p>
<p class="small">{{ 'If it wasn\'t you, nothing has changed: you can ignore this message.'|trans }}</p>
{% endblock %}
