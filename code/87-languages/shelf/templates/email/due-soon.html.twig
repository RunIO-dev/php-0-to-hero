{% extends 'email/base.html.twig' %}

{% block body %}
<p>{{ 'Hello {name},'|trans({name: name}) }}</p>
<p>{{ '“{title}” is due back on {day}. You can extend it on your loans page, unless someone has reserved it.'|trans({title: title, day: day|format_date('full', timezone: false)}) }}</p>
<p><a class="button" href="{{ link }}">{{ 'My loans'|trans }}</a></p>
{% endblock %}
