  Name             Method     Path                      
 ---------------- ---------- -------------------------- 
  _preview_error   ANY        /_error/{code}.{_format}  
  login            GET|POST   /login                    
  logout           POST       /logout                   
  loans            GET        /loans                    
  api_books        GET        /api/books                
  api_book         GET        /api/book                 
  api_add          POST       /api/books                
  api_login        POST       /api/tokens               
  api_logout       DELETE     /api/tokens               
  api_loans        GET        /api/loans                
  books            GET        /                         
  book             GET        /book                     
  add              GET|POST   /add                      
  copies           POST       /copies                   
  remove           POST       /remove                   
  cover            GET        /cover                    
