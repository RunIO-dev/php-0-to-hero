<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Log in · Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav>
            <a href="/">Books</a>
            <a href="/login">Log in</a>
        </nav>
    </header>
    <main>
    <h1>Log in</h1>
    <p class="flash" role="status">Log in first.</p>
    <form class="card narrow" method="post" action="/login">
        <input type="hidden" name="_token" value="{{token}}">
        <label>Name <input name="name" value="" required autocomplete="username"></label>
        <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
        <p class="actions"><button>Log in</button></p>
    </form>
    </main>
</body>
</html>

