            <a href="/">Books</a>
            <a href="/loans">My loans</a>
            <a class="button" href="/add">Add a book</a>
            <form class="who" method="post" action="/logout">
                <input type="hidden" name="_token" value="…">
                <span>Jonas</span> <button class="link">Log out</button>
            </form>
        </nav>
    </header>
    <main>
    <h1>Books</h1>
    <p class="flash" role="status">Added &quot;Sula&quot;.</p>
    <ul class="books">
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2><a href="/book?title=Kindred">Kindred</a></h2>
            <p>Octavia E. Butler, 1979</p>
            <p class="status on-loan">All copies on loan</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">K</span>
            <h2><a href="/book?title=Kitchen">Kitchen</a></h2>
            <p>Banana Yoshimoto, 1988</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <span class="cover" aria-hidden="true">P</span>
            <h2><a href="/book?title=Parable%20of%20the%20Sower">Parable of the Sower</a></h2>
            <p>Octavia E. Butler, 1993</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
            <img class="cover" src="/cover?title=Sula" alt="">
            <h2><a href="/book?title=Sula">Sula</a></h2>
            <p>Toni Morrison, 1973</p>
            <p class="status">Available</p>
        </li>
        <li class="book">
