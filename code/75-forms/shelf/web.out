<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add a book · Shelf</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site">
        <a class="brand" href="/">Shelf</a>
        <nav>
            <a href="/">Books</a>
            <a href="/loans">My loans</a>
            <a class="button" href="/add">Add a book</a>
            <form class="who" method="post" action="/logout">
                <input type="hidden" name="_token" value="…">
                <span>Jonas</span> <button class="link">Log out</button>
            </form>
        </nav>
    </header>
    <main>
    <h1>Add a book</h1>
    <form method="post" action="/add" class="card" enctype="multipart/form-data">
        <label>Title <input type="text" id="title" name="title" required="required" maxlength="200" /></label>
        <label>Author <input type="text" id="author" name="author" required="required" maxlength="200" /></label>
        <label>Year <input type="number" id="year" name="year" required="required" inputmode="numeric" /></label>
        <label>ISBN <small>optional</small> <input type="text" id="isbn" name="isbn" /></label>
        <label>Cover <small>PNG or JPEG, up to 2 MB, optional</small>
            <input type="file" id="cover" name="cover" accept="image/png, image/jpeg" /></label>
        <p class="actions"><button>Add the book</button> <a href="/">Cancel</a></p>
    <input type="hidden" id="_token" name="_token" data-controller="csrf-protection" value="…" /></form>
    </main>
</body>
</html>

