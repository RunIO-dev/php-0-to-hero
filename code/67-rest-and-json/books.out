{
    "id": 4,
    "title": "Parable of the Sower",
    "author": "Octavia E. Butler",
    "year": 1993
}

> POST /books.php
> Content-Type: application/json
>
> {"title": "Kitchen",

< HTTP/1.1 400 Bad Request
< Content-Type: application/json

{
    "error": "The body must be JSON."
}

> POST /books.php
> Content-Type: application/json
>
> {"title": "Kitchen", "author": "Banana Yoshimoto", "year": "1988"}

< HTTP/1.1 422 Unknown Status Code
< Content-Type: application/json

{
    "error": "A book needs a title, an author and a year, as a number."
}

> DELETE /books.php

< HTTP/1.1 405 Method Not Allowed
< Allow: GET, POST
< Content-Type: application/json

{
    "error": "Use GET or POST."
}
