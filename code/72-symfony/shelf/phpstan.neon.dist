# Static analysis for Shelf (chapter 40; its tests from chapter 41, its web pages from 46, templates from 49), at the highest level. From the course folder:
#   vendor/bin/phpstan analyse -c shelf/phpstan.neon.dist
parameters:
    level: 10
    # Shelf's own packages (Symfony from chapter 72), which the course's autoloader doesn't know.
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - shelf.php
        - src
        - tests
        - public
        - config
        - templates
    excludePaths:
        - '*/config/reference.php' # made by Symfony in debug mode, for configuration written in PHP
    ignoreErrors:
        # PHP always sets $argv when it runs a script from the command line.
        -
            message: '#^Variable \$argv might not be defined\.$#'
            path: shelf.php
