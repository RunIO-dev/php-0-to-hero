                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h3v18H6a2 2 0 0 1-2-2Z"/><path d="M9 3h4v18H9"/><path d="m14 4.5 3.8-1 3.2 15.5-3.8 1Z"/></svg>
                Shelf
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/" aria-current="page">Books</a>
                <a href="/loans">My loans</a>
                <form class="account" method="post" action="/logout">
                    <input type="hidden" name="_token" value="…">
                    <span class="who">Amira</span> <button class="link">Log out</button>
                </form>
            </nav>
        </div>
    </header>
    <main id="main">
    <div class="page-head">
        <div>
            <h1>Books</h1>
            <p class="lead">Everything on the shelf, and what is on loan.</p>
        </div>
    </div>
    <p class="flash" role="status">Welcome, Amira.</p>
    <form class="search" method="get" action="/" role="search">
        <label class="grow">Search
            <input type="search" name="q" value="" maxlength="100" placeholder="Title, author or ISBN">
        </label>
        <label>Sort by
            <select name="sort">
                <option value="title" selected>Title, A to Z</option>
                <option value="author">Author, A to Z</option>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
            </select>
        </label>
        <label class="check"><input type="checkbox" name="available" value="1"> Only on the shelf</label>
        <button type="submit">Search</button>
    </form>
    <p class="count" role="status">
        57 books · page 1 of 5    </p>
    <ul class="books">
<li class="book-card">
    <span class="cover tone-0" aria-hidden="true">A</span>
    <h2><a href="/book?title=Adventures%20of%20Huckleberry%20Finn">Adventures of Huckleberry Finn</a></h2>
    <p class="by">Mark Twain · 1884</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
    <span class="cover tone-1" aria-hidden="true">A</span>
    <h2><a href="/book?title=All%20Quiet%20on%20the%20Western%20Front">All Quiet on the Western Front</a></h2>
    <p class="by">Erich Maria Remarque · 1929</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
    <span class="cover tone-5" aria-hidden="true">A</span>
    <h2><a href="/book?title=Americanah">Americanah</a></h2>
    <p class="by">Chimamanda Ngozi Adichie · 2013</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
    <span class="cover tone-4" aria-hidden="true">A</span>
    <h2><a href="/book?title=Animal%20Farm">Animal Farm</a></h2>
    <p class="by">George Orwell · 1945</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
    <span class="cover tone-4" aria-hidden="true">A</span>
    <h2><a href="/book?title=Anna%20Karenina">Anna Karenina</a></h2>
    <p class="by">Leo Tolstoy · 1878</p>
<span class="badge warn">On loan</span>
</li>
<li class="book-card">
    <span class="cover tone-5" aria-hidden="true">B</span>
    <h2><a href="/book?title=Beloved">Beloved</a></h2>
    <p class="by">Toni Morrison · 1987</p>
<span class="badge warn">On loan</span>
</li>
<li class="book-card">
    <span class="cover tone-1" aria-hidden="true">B</span>
    <h2><a href="/book?title=Brave%20New%20World">Brave New World</a></h2>
    <p class="by">Aldous Huxley · 1932</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
    <span class="cover tone-2" aria-hidden="true">B</span>
    <h2><a href="/book?title=Buddenbrooks">Buddenbrooks</a></h2>
    <p class="by">Thomas Mann · 1901</p>
<span class="badge ok">Available</span>
</li>
<li class="book-card">
