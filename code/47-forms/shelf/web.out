> GET /add.php

< HTTP/1.1 200 OK
< Content-type: text/html; charset=UTF-8

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Add a book · Shelf</title>
</head>
<body>
    <h1>Add a book</h1>
    <form method="post" action="/add.php">
        <label>Title <input name="title" value="" required maxlength="200"></label>
        <label>Author <input name="author" value="" required maxlength="200"></label>
        <label>Year <input name="year" value="" required inputmode="numeric"></label>
        <label>ISBN <input name="isbn" value=""></label>
        <button>Add</button>
    </form>
    <p><a href="/">Back to the list</a></p>
</body>
</html>

